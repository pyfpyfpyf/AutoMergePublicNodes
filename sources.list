# ============================================================
# 配置文件的语法：
# 行首的 '#' 表示此行为注释。
# 行首的 '!' 表示这行订阅在国内下载不了。
# 行首的 '+' 表示这行订阅的 URL 带有动态内容，其中：
#     +date 表示 URL 中含有需动态填入的日期。
# 行首的 '*' 表示这是一个订阅列表，即这个文件中的每一行又是一个订阅
# 行末可以在 '#' 后添加参数，格式为常规 URL 格式，如 '#max=100&ignore=vmess,ss'
#     其中 max=N 表示如果订阅提供的订阅多于 N 个则忽略订阅，
#     ignore=A,B,C 表示忽略其中协议为 A,B 或 C 的节点。
# 一行 'EOF' 表示配置文件结束，忽略下方所有内容。
# ============================================================


# ===== Clash YAML 精选源 (2026-07-14) =====

# Au1rxx/free-vpn-subscriptions (每小时更新, HTTP-over-proxy验证, ~94节点)
https://raw.githubusercontent.com/Au1rxx/free-vpn-subscriptions/main/output/clash.yaml

# rtwo2/FastNodes (每6小时更新, TCP存活+质量排序, 忽略ss避免cipher:auto报错)
https://raw.githubusercontent.com/rtwo2/FastNodes/main/sub/protocols/vless.yaml#ignore=ss
https://raw.githubusercontent.com/rtwo2/FastNodes/main/sub/protocols/trojan.yaml#ignore=ss
https://raw.githubusercontent.com/rtwo2/FastNodes/main/sub/protocols/vmess.yaml#ignore=ss
https://raw.githubusercontent.com/rtwo2/FastNodes/main/sub/protocols/hysteria2.yaml#ignore=ss

# zhuhaiuk/free-nodes (每小时更新, zhuhai.uk节点)
https://raw.githubusercontent.com/zhuhaiuk/free-nodes/main/clash_config.yaml

# zhangkaiitugithub/passcro (speed_node来源, 忽略ss)
https://raw.githubusercontent.com/zhangkaiitugithub/passcro/main/speednodes.yaml#ignore=vmess,ss,ssr

# Barabama/FreeNodes (yudou789/v2cross/保加利亚/美国, 忽略ss)
https://raw.githubusercontent.com/Barabama/FreeNodes/main/nodes/yudou66.yaml#ignore=ss
https://raw.githubusercontent.com/Barabama/FreeNodes/main/nodes/nodefree.yaml#ignore=ss
https://raw.githubusercontent.com/Barabama/FreeNodes/main/nodes/blues.yaml#ignore=ss
https://raw.githubusercontent.com/Barabama/FreeNodes/main/nodes/clashmeta.yaml#ignore=ss
